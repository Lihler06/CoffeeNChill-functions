{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information",
      "Host.Results": "Information",
      "Azure.Core": "Error",
      "Azure.Messaging": "Error"
    }
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:02",
      "visibilityTimeout": "00:00:10",
      "batchSize": 4,
      "newBatchThreshold": 2,
      "maxDequeueCount": 3,
      "messageEncoding": "base64"
    }
  }
}